# Environment Configuration
# Copy to .env and update values for your deployment

# Application Environment: development or production
ENVIRONMENT=development

# Frontend URL (where your React app is hosted)
# Local: http://localhost:5173
# Production: https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Cookie Security Settings
# For DEVELOPMENT (localhost): secure=false, samesite=lax
# For PRODUCTION (HTTPS cross-origin): secure=true, samesite=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database URL (PostgreSQL/Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/advisor_db

# OpenRouter (LLM provider) — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Any model slug OpenRouter supports, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini
# Used only for OpenRouter's attribution headers — not secret
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Advisor Console

# Google Docs advisor context (service account must have access to both docs)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"service-account@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id"}
# Or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.
GOOGLE_SYSTEM_PROMPT_DOCUMENT_ID=1ujFrCT7jG7PzeVcQIsunTXUDa9keuamYY-55k_lkl4
GOOGLE_GROUNDING_DOCUMENT_ID=17rH7oJj3XwwVGZMk_T5JnK-efpiKB-Vi1Z-yXf_y3Lk
GOOGLE_DOCS_CACHE_TTL_SECONDS=300