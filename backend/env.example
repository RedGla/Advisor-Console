# Environment Configuration
# Copy to .env and update values for your deployment

# Application Environment: development or production
ENVIRONMENT=development

# Frontend URL (where your React app is hosted)
# Local: http://localhost:5173
# Production: https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Cookie Security Settings
# For DEVELOPMENT (localhost): secure=false, samesite=lax
# For PRODUCTION (HTTPS cross-origin): secure=true, samesite=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database URL (PostgreSQL/Supabase)
DATABASE_URL="postgresql://postgres.tugxqyyotaaibjxbexmh:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# OpenRouter (LLM provider) — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model slug OpenRouter supports, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini
# Used only for OpenRouter's attribution headers — not secret
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Advisor Console