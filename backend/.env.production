# Production Environment Configuration
# Use these settings when deploying to production (Render backend + Vercel frontend)

ENVIRONMENT=production

# Frontend URL - Replace with your actual Vercel deployment URL
# Example: https://your-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app

# CRITICAL for Cross-Origin Cookies:
# When frontend and backend are on different origins (e.g., vercel.app + render.com),
# cookies must have these settings to work:
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Database URL for production
# DATABASE_URL=postgresql://user:password@your-render-db.com/advisor_console

# JWT Secret (if implementing JWT in future)
# SECRET_KEY=your-production-secret-key-here
