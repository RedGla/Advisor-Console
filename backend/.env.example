# Application & Local Environment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database Configuration (PostgreSQL / Supabase)
# Note: Percent-encode special characters in password (e.g., & -> %26, $ -> %24)
DATABASE_URL=postgresql://user:password@localhost:5432/advisor_db

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Advisor Console

# Google Docs Advisor Context Pipeline
GOOGLE_DOCS_PROMPT_ID=1ujFrCT7jG7PzeVcQIsunTXUDa9keuamYY-55k_lkl_4
GOOGLE_DOCS_GROUNDING_ID=17rH7oJj3XwwVGZMk_T5JnK-efpiKB-Vi1Z-yXf_y3Lk
GOOGLE_DOCS_CACHE_TTL_SECONDS=300

# Google Service Account Credentials (Minified JSON string wrapped in single quotes)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"service-account@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id"}'